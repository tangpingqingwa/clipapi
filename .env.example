# Copy to .env on the VPS. Never commit real secrets.

# Process binds 0.0.0.0:$PORT (default 3000).
PORT=3000

NODE_ENV=production

# Required when NODE_ENV=production. Persist this path on a volume.
CLIPAPI_DATABASE=/app/data/clipapi.sqlite

# Checkout success/cancel origin. Default http://localhost:3000.
# PUBLIC_BASE_URL=https://api.clipapi.dev

# Optional first key when the keys table is empty. ck_live_... or ck_test_...
# CLIPAPI_BOOTSTRAP_KEY=ck_live_replace_me

# Live TikTok is off unless CLIPAPI_LIVE=1. CLIPAPI_FIXTURE_ONLY=1 always wins (CI).
# CLIPAPI_LIVE=1
# CLIPAPI_FIXTURE_ONLY=1

# Stripe stays commented. Checkout fails closed without a live StripePort.
# Webhook HMAC needs STRIPE_WEBHOOK_SECRET; missing/invalid signature → 400.
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
